# systemd user unit for the rnfs daemon.
#
#   mkdir -p ~/.config/systemd/user
#   cp contrib/rnfs.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now rnfs
#   journalctl --user -u rnfs -f          # logs
#
# To keep it running while you're logged out: loginctl enable-linger $USER
# ExecStart assumes `pipx install` (which puts rnfs in ~/.local/bin); adjust the path otherwise (keep it in
# double quotes, and write a literal % as %% and $ as $$).

[Unit]
Description=rnfs: content-addressed file sharing over Reticulum
# Start after rnsd if it also runs as a user service, so rnfs attaches to it rather than starting its own instance
After=rnsd.service
# Give up after 5 failed starts in 10 minutes (e.g. the command is missing) instead of retrying forever
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
ExecStart="%h/.local/bin/rnfs" daemon
Restart=on-failure
RestartSec=10
# The daemon shuts down cleanly on SIGTERM, saving provider records and RNS state
KillSignal=SIGTERM
TimeoutStopSec=30
# Sandboxing that works in a user unit too. Serial devices (RNode, KISS) are unaffected; Bluetooth RNodes are
# reached through BlueZ's D-Bus (AF_UNIX). An interface program run by a PipeInterface inherits these limits:
# if it needs another socket family (e.g. AF_PACKET), add it with systemctl --user edit rnfs.
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
# Only the system calls ordinary services make, for this machine's own architecture (seccomp, which works in a
# user unit because NoNewPrivileges is set). A PipeInterface's program is held to the same. MemoryDenyWriteExecute
# is left out: libffi closures, which cffi (under cryptography) can use, may need writable executable memory.
SystemCallFilter=@system-service
SystemCallArchitectures=native
# ProtectSystem and PrivateTmp are left out: in a user unit they need unprivileged user namespaces, which some
# systems turn off. Where that works, add them with the drop-in in contrib/rnfs.service.d/hardening.conf
# (https://github.com/afit21/rnfs/blob/main/contrib/rnfs.service.d/hardening.conf). UMask is left out too: what
# `rnfs get` writes gets its permissions from your umask.

[Install]
WantedBy=default.target
